APP_NAME=SmartChef Backend
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/smartchef_v2
DATABASE_RUN_CREATE_ALL=false

# 默认账密 admin / Abc12345（见 SEED_ADMIN_PASSWORD）。Alembic 只建表不写数据；须 bootstrap 或启动一次后端写入 seed。
# 已有表但 user_account 为空：cd backend && python scripts/seed_data.py

# pytest 使用独立库（默认 smartchef_v2_test）；见 tests/constants.py。勿指向与开发相同的数据库名。
# 推荐使用 scripts/bootstrap_db.py 一次性创建库、迁移并 seed。
# DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/smartchef_v2_test

# 默认 true：任意前端源可访问（JWT 走 Authorization，无需 cookie 跨域）。
# 生产建议：CORS_ALLOW_ALL=false，并配置 CORS_ALLOW_ORIGINS JSON 白名单
CORS_ALLOW_ALL=true
# uvicorn 示例：python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8005
CORS_ALLOW_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173"]
