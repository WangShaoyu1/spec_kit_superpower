APP_NAME=SmartChef Backend
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/smartchef

# pytest 使用独立库（默认 smartchef_test）；见 tests/constants.py。勿指向与开发相同的数据库名。
# 本地需先创建: CREATE DATABASE smartchef_test;
# DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/smartchef_test

# 默认 true：任意前端源可访问（JWT 走 Authorization，无需 cookie 跨域）。
# 生产建议：CORS_ALLOW_ALL=false，并配置 CORS_ALLOW_ORIGINS JSON 白名单
CORS_ALLOW_ALL=true
# uvicorn 示例：python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8005
CORS_ALLOW_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173"]
